/* ─── BACKGROUND PARTICLES ─── */
const bgCanvas = document.getElementById('bgCanvas');
const bgCtx = bgCanvas.getContext('2d');
bgCanvas.width = window.innerWidth; bgCanvas.height = window.innerHeight;
const particles = Array.from({length:80},()=>({x:Math.random()*bgCanvas.width,y:Math.random()*bgCanvas.height,r:Math.random()*1.5+0.5,vx:(Math.random()-0.5)*0.3,vy:(Math.random()-0.5)*0.3}));
function animBg(){bgCtx.clearRect(0,0,bgCanvas.width,bgCanvas.height);particles.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>bgCanvas.width)p.vx*=-1;if(p.y<0||p.y>bgCanvas.height)p.vy*=-1;bgCtx.beginPath();bgCtx.arc(p.x,p.y,p.r,0,Math.PI*2);bgCtx.fillStyle='rgba(0,255,136,0.4)';bgCtx.fill();});requestAnimationFrame(animBg);}
animBg();
window.addEventListener('resize',()=>{bgCanvas.width=window.innerWidth;bgCanvas.height=window.innerHeight;});

/* ─── SKILL ROADMAP TOGGLES ─── */
function toggleRoadmap(skill) {
    const rm = document.getElementById('roadmap-'+skill);
    const btn = rm.closest('.skill-mega-card').querySelector('.toggle-roadmap');
    const isOpen = rm.classList.contains('open');
    document.querySelectorAll('.smc-roadmap').forEach(r=>r.classList.remove('open'));
    document.querySelectorAll('.toggle-roadmap').forEach(b=>{b.innerHTML='<i class="fas fa-map"></i> View Roadmap';});
    if(!isOpen){rm.classList.add('open');btn.innerHTML='<i class="fas fa-times"></i> Close Roadmap';}
}

/* ─── LEVEL TABS ─── */
document.querySelectorAll('.level-tab').forEach(tab=>{
    tab.addEventListener('click',()=>{
        document.querySelectorAll('.level-tab').forEach(t=>t.classList.remove('active'));
        document.querySelectorAll('.roadmap-level').forEach(l=>l.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(tab.dataset.level).classList.add('active');
    });
});

/* ─── VIZ TABS ─── */
document.querySelectorAll('.tab-btn').forEach(btn=>{
