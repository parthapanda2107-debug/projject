document.querySelectorAll('.ds-tab').forEach(tab=>{
    tab.addEventListener('click',()=>{
        document.querySelectorAll('.ds-tab').forEach(t=>t.classList.remove('active'));
        document.querySelectorAll('.ds-content').forEach(c=>c.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('ds-'+tab.dataset.ds).classList.add('active');
    });
});

/* ═══════════════════════════════════════════════
   SORTING VISUALIZER
═══════════════════════════════════════════════ */
const sortCanvas = document.getElementById('sortCanvas');
const sCtx = sortCanvas.getContext('2d');
let sortArray = [], isSorting = false;
const sortInfo = { bubble:'Bubble Sort: O(n²) — compares adjacent pairs and swaps', quick:'Quick Sort: O(n log n) avg — divide and conquer with pivot', merge:'Merge Sort: O(n log n) — splits and merges sorted halves', insertion:'Insertion Sort: O(n²) — builds sorted array one item at a time', selection:'Selection Sort: O(n²) — finds minimum and places it at front' };
const COLORS = { normal:'#1e3a5f', compare:'#ff4444', sorted:'#00ff88', pivot:'#ffd93d', min:'#a855f7' };
let highlighted = {}, sortedIdx = new Set();

function initSort(){ sortArray=[]; sortedIdx=new Set(); highlighted={}; for(let i=0;i<60;i++) sortArray.push(Math.floor(Math.random()*380+20)); drawSort(); }
function drawSort(){
    sCtx.clearRect(0,0,sortCanvas.width,sortCanvas.height);
    const bw = sortCanvas.width/sortArray.length;
    sortArray.forEach((v,i)=>{
        const h=(v/400)*(sortCanvas.height-40);
        let col = sortedIdx.has(i)?COLORS.sorted: highlighted.pivot===i?COLORS.pivot: highlighted.compare?.includes(i)?COLORS.compare: highlighted.min===i?COLORS.min: COLORS.normal;
        const grad=sCtx.createLinearGradient(0,sortCanvas.height-h-10,0,sortCanvas.height-10);
        grad.addColorStop(0,col); grad.addColorStop(1,col+'88');
        sCtx.fillStyle=grad;
        sCtx.beginPath();
        sCtx.roundRect(i*bw+1,sortCanvas.height-h-10,bw-2,h,3);
        sCtx.fill();
    });
}
const delay = ()=>new Promise(r=>setTimeout(r,Math.max(5,60-document.getElementById('sortSpeed').value*5)));

async function bubbleSort(){
    for(let i=0;i<sortArray.length;i++){
        for(let j=0;j<sortArray.length-i-1;j++){
            highlighted={compare:[j,j+1]};drawSort();await delay();
            if(sortArray[j]>sortArray[j+1])[sortArray[j],sortArray[j+1]]=[sortArray[j+1],sortArray[j]];
        }
        sortedIdx.add(sortArray.length-1-i);
    }
    sortedIdx=new Set(sortArray.map((_,i)=>i));highlighted={};drawSort();
}
async function insertionSort(){
    for(let i=1;i<sortArray.length;i++){
        let key=sortArray[i],j=i-1;
        while(j>=0&&sortArray[j]>key){
            highlighted={compare:[j,j+1]};drawSort();await delay();
            sortArray[j+1]=sortArray[j];j--;
        }
        sortArray[j+1]=key;
        for(let k=0;k<=i;k++)sortedIdx.add(k);
    }
    sortedIdx=new Set(sortArray.map((_,i)=>i));highlighted={};drawSort();
}
async function selectionSort(){
    for(let i=0;i<sortArray.length;i++){
        let minI=i;
        for(let j=i+1;j<sortArray.length;j++){
            highlighted={compare:[j,i],min:minI};drawSort();await delay();
            if(sortArray[j]<sortArray[minI])minI=j;
        }
        [sortArray[i],sortArray[minI]]=[sortArray[minI],sortArray[i]];
        sortedIdx.add(i);
    }
    sortedIdx=new Set(sortArray.map((_,i)=>i));highlighted={};drawSort();
}
async function quickSort(lo,hi){
    if(lo>=hi)return;
    const pi=await qPartition(lo,hi);
    await quickSort(lo,pi-1);
    await quickSort(pi+1,hi);
}
async function qPartition(lo,hi){
    const pivot=sortArray[hi];highlighted={pivot:hi};
    let i=lo-1;
    for(let j=lo;j<hi;j++){
        highlighted={pivot:hi,compare:[j,i+1]};drawSort();await delay();
        if(sortArray[j]<=pivot){i++;[sortArray[i],sortArray[j]]=[sortArray[j],sortArray[i]];}
    }
    [sortArray[i+1],sortArray[hi]]=[sortArray[hi],sortArray[i+1]];
    return i+1;
}
async function mergeSortRun(lo,hi){
    if(lo>=hi)return;
    const mid=Math.floor((lo+hi)/2);
    await mergeSortRun(lo,mid);
    await mergeSortRun(mid+1,hi);
    await mergeArr(lo,mid,hi);
}
async function mergeArr(lo,mid,hi){
    const left=sortArray.slice(lo,mid+1),right=sortArray.slice(mid+1,hi+1);
    let i=0,j=0,k=lo;
    while(i<left.length&&j<right.length){
        highlighted={compare:[k]};drawSort();await delay();
        if(left[i]<=right[j])sortArray[k++]=left[i++];
        else sortArray[k++]=right[j++];
    }
    while(i<left.length)sortArray[k++]=left[i++];
    while(j<right.length)sortArray[k++]=right[j++];
}

document.getElementById('startSort').addEventListener('click',async()=>{
    if(isSorting)return; isSorting=true;sortedIdx=new Set();
    const algo=document.getElementById('sortAlgo').value;
    document.getElementById('sortInfo').textContent=sortInfo[algo];
    if(algo==='bubble')await bubbleSort();
    else if(algo==='insertion')await insertionSort();
    else if(algo==='selection')await selectionSort();
    else if(algo==='quick'){await quickSort(0,sortArray.length-1);sortedIdx=new Set(sortArray.map((_,i)=>i));highlighted={};drawSort();}
    else if(algo==='merge'){await mergeSortRun(0,sortArray.length-1);sortedIdx=new Set(sortArray.map((_,i)=>i));highlighted={};drawSort();}
    isSorting=false;
});
document.getElementById('shuffle').addEventListener('click',()=>{if(!isSorting){initSort();document.getElementById('sortInfo').textContent='Array shuffled — select algorithm and press Visualize';}});
document.getElementById('resetSort').addEventListener('click',()=>{if(!isSorting){isSorting=false;initSort();}});
initSort();

/* ═══════════════════════════════════════════════
   BINARY TREE VISUALIZER
═══════════════════════════════════════════════ */
const treeCanvas=document.getElementById('treeCanvas');
const tCtx=treeCanvas.getContext('2d');
let bstRoot=null, highlightedNodes=new Set();
class TNode{constructor(v){this.v=v;this.l=null;this.r=null;}}
function bstInsert(n,v){if(!n)return new TNode(v);if(v<n.v)n.l=bstInsert(n.l,v);else if(v>n.v)n.r=bstInsert(n.r,v);return n;}
function buildBST(){
    const vals=document.getElementById('treeData').value.split(',').map(x=>parseInt(x.trim())).filter(x=>!isNaN(x));
    bstRoot=null;vals.forEach(v=>bstRoot=bstInsert(bstRoot,v));
    highlightedNodes=new Set();drawTree();
    document.getElementById('treeInfo').textContent=`BST built with ${vals.length} nodes`;
}
function calcPositions(node,lo,hi,depth,positions){
    if(!node)return;
    const x=(lo+hi)/2,y=60+depth*90;
    positions.set(node,{x,y});
    calcPositions(node.l,lo,(lo+hi)/2,depth+1,positions);
    calcPositions(node.r,(lo+hi)/2,hi,depth+1,positions);
}
function drawTree(){
    tCtx.clearRect(0,0,treeCanvas.width,treeCanvas.height);
    if(!bstRoot)return;
    const pos=new Map();calcPositions(bstRoot,0,treeCanvas.width,0,pos);
    pos.forEach(({x,y},node)=>{
        if(node.l&&pos.has(node.l)){const c=pos.get(node.l);tCtx.beginPath();tCtx.moveTo(x,y+20);tCtx.lineTo(c.x,c.y-20);tCtx.strokeStyle='rgba(0,212,255,0.5)';tCtx.lineWidth=2;tCtx.stroke();}
        if(node.r&&pos.has(node.r)){const c=pos.get(node.r);tCtx.beginPath();tCtx.moveTo(x,y+20);tCtx.lineTo(c.x,c.y-20);tCtx.strokeStyle='rgba(168,85,247,0.5)';tCtx.lineWidth=2;tCtx.stroke();}
    });
    pos.forEach(({x,y},node)=>{
        const isH=highlightedNodes.has(node.v);
        tCtx.beginPath();tCtx.arc(x,y,22,0,Math.PI*2);
        tCtx.fillStyle=isH?'#ffd93d':'rgba(0,255,136,0.9)';tCtx.fill();
        tCtx.strokeStyle=isH?'#ff8800':'#00aa55';tCtx.lineWidth=2;tCtx.stroke();
        tCtx.fillStyle='#000';tCtx.font='bold 13px Exo 2,sans-serif';
        tCtx.textAlign='center';tCtx.textBaseline='middle';tCtx.fillText(node.v,x,y);
    });
}
async function traverseHighlight(nodes){
    highlightedNodes=new Set();drawTree();
    for(const v of nodes){
        highlightedNodes.add(v);drawTree();
        await new Promise(r=>setTimeout(r,500));
    }
    document.getElementById('treeInfo').textContent='Traversal: '+nodes.join(' → ');
}
function inorderArr(n,res=[]){if(!n)return res;inorderArr(n.l,res);res.push(n.v);inorderArr(n.r,res);return res;}
function preorderArr(n,res=[]){if(!n)return res;res.push(n.v);preorderArr(n.l,res);preorderArr(n.r,res);return res;}
function postorderArr(n,res=[]){if(!n)return res;postorderArr(n.l,res);postorderArr(n.r,res);res.push(n.v);return res;}

document.getElementById('buildTree').addEventListener('click',buildBST);
document.getElementById('inorder').addEventListener('click',()=>{if(bstRoot)traverseHighlight(inorderArr(bstRoot));});
document.getElementById('preorder').addEventListener('click',()=>{if(bstRoot)traverseHighlight(preorderArr(bstRoot));});
document.getElementById('postorder').addEventListener('click',()=>{if(bstRoot)traverseHighlight(postorderArr(bstRoot));});
buildBST();

/* ═══════════════════════════════════════════════
   GRAPH BFS / DFS
═══════════════════════════════════════════════ */
const graphCanvas=document.getElementById('graphCanvas');
const gCtx=graphCanvas.getContext('2d');
let gNodes=[],gEdges=[],gVisited=new Set(),gQueue=[],gOrder=[];
function genGraph(){
    gNodes=[];gEdges=[];
    const n=9;
    const cx=graphCanvas.width/2,cy=graphCanvas.height/2,r=160;
    for(let i=0;i<n;i++) gNodes.push({x:cx+r*Math.cos(i*2*Math.PI/n-Math.PI/2),y:cy+r*Math.sin(i*2*Math.PI/n-Math.PI/2),id:i});
    const adj=Array.from({length:n},()=>[]);
    for(let i=0;i<n;i++) for(let j=i+1;j<n;j++) if(Math.random()>0.55){gEdges.push({a:i,b:j});adj[i].push(j);adj[j].push(i);}
    gVisited=new Set();gOrder=[];gQueue=[];
    drawGraph([],[],'Graph generated. Run BFS or DFS from node 0.');
    return adj;
}
function drawGraph(visited,path,msg=''){
    gCtx.clearRect(0,0,graphCanvas.width,graphCanvas.height);
    gEdges.forEach(e=>{
        const a=gNodes[e.a],b=gNodes[e.b];
        const inPath=path.includes(e.a)&&path.includes(e.b);
        gCtx.beginPath();gCtx.moveTo(a.x,a.y);gCtx.lineTo(b.x,b.y);
        gCtx.strokeStyle=inPath?'rgba(0,255,136,0.7)':'rgba(255,255,255,0.1)';
        gCtx.lineWidth=inPath?2.5:1;gCtx.stroke();
    });
    gNodes.forEach(n=>{
        gCtx.beginPath();gCtx.arc(n.x,n.y,22,0,Math.PI*2);
        if(n.id===0)gCtx.fillStyle='#ffd93d';
        else if(visited.includes(n.id))gCtx.fillStyle='#00ff88';
        else gCtx.fillStyle='rgba(168,85,247,0.7)';
        gCtx.fill();gCtx.strokeStyle='rgba(255,255,255,0.3)';gCtx.lineWidth=2;gCtx.stroke();
        gCtx.fillStyle='#000';gCtx.font='bold 14px monospace';
        gCtx.textAlign='center';gCtx.textBaseline='middle';gCtx.fillText(n.id,n.x,n.y);
    });
    if(msg) document.getElementById('graphInfo').textContent=msg;
}
let adjList=genGraph();

async function bfs(){
    if(!gNodes.length)return;
    const visited=[],queue=[0];const seen=new Set([0]);
    while(queue.length){
        const cur=queue.shift();visited.push(cur);
        drawGraph(visited,visited,`BFS visiting: ${cur} → order: [${visited.join(',')}]`);
        await new Promise(r=>setTimeout(r,600));
        (adjList[cur]||[]).forEach(nb=>{if(!seen.has(nb)){seen.add(nb);queue.push(nb);}});
    }
    drawGraph(visited,visited,`BFS complete: [${visited.join(' → ')}]`);
}
async function dfs(){
    if(!gNodes.length)return;
    const visited=[],stack=[0];const seen=new Set();
    while(stack.length){
        const cur=stack.pop();if(seen.has(cur))continue;
        seen.add(cur);visited.push(cur);
        drawGraph(visited,visited,`DFS visiting: ${cur} → order: [${visited.join(',')}]`);
        await new Promise(r=>setTimeout(r,600));
        (adjList[cur]||[]).forEach(nb=>{if(!seen.has(nb))stack.push(nb);});
    }
    drawGraph(visited,visited,`DFS complete: [${visited.join(' → ')}]`);
}

document.getElementById('runBFS').addEventListener('click',bfs);
document.getElementById('runDFS').addEventListener('click',dfs);
document.getElementById('newGraph').addEventListener('click',()=>{adjList=genGraph();});

/* ═══════════════════════════════════════════════
   NETWORK GRAPH
═══════════════════════════════════════════════ */
const networkCanvas=document.getElementById('networkCanvas');
const nCtx=networkCanvas.getContext('2d');
let netNodes=[],netEdges=[];
class NetNode{constructor(x,y){this.x=x;this.y=y;this.vx=(Math.random()-.5)*1;this.vy=(Math.random()-.5)*1;this.r=16+Math.random()*10;this.color=`hsl(${Math.random()*360},70%,55%)`;}}
function generateNet(){
    netNodes=[];netEdges=[];
    for(let i=0;i<14;i++) netNodes.push(new NetNode(Math.random()*(networkCanvas.width-100)+50,Math.random()*(networkCanvas.height-100)+50));
    for(let i=0;i<netNodes.length;i++) for(let j=i+1;j<netNodes.length;j++) if(Math.random()>.65) netEdges.push({a:i,b:j});
}
function animNet(){
    nCtx.clearRect(0,0,networkCanvas.width,networkCanvas.height);
    netEdges.forEach(e=>{
        const a=netNodes[e.a],b=netNodes[e.b];
        const dx=b.x-a.x,dy=b.y-a.y,d=Math.sqrt(dx*dx+dy*dy);
        nCtx.beginPath();nCtx.moveTo(a.x,a.y);nCtx.lineTo(b.x,b.y);
        nCtx.strokeStyle=`rgba(0,255,136,${Math.max(0,0.5-d/600)})`;nCtx.lineWidth=1.5;nCtx.stroke();
    });
    netNodes.forEach((n,i)=>{
        n.vx*=0.97;n.vy*=0.97;n.x+=n.vx;n.y+=n.vy;
        if(n.x<n.r)n.vx=Math.abs(n.vx);if(n.x>networkCanvas.width-n.r)n.vx=-Math.abs(n.vx);
        if(n.y<n.r)n.vy=Math.abs(n.vy);if(n.y>networkCanvas.height-n.r)n.vy=-Math.abs(n.vy);
        netNodes.forEach(o=>{if(o!==n){const dx=n.x-o.x,dy=n.y-o.y,d=Math.sqrt(dx*dx+dy*dy);if(d<120&&d>0){n.vx+=dx/d*.3;n.vy+=dy/d*.3;}}});
        nCtx.beginPath();nCtx.arc(n.x,n.y,n.r,0,Math.PI*2);
        const g=nCtx.createRadialGradient(n.x,n.y,0,n.x,n.y,n.r);
        g.addColorStop(0,n.color);g.addColorStop(1,n.color+'44');
        nCtx.fillStyle=g;nCtx.fill();nCtx.strokeStyle='rgba(255,255,255,0.3)';nCtx.lineWidth=1.5;nCtx.stroke();
        nCtx.fillStyle='#fff';nCtx.font='bold 11px monospace';nCtx.textAlign='center';nCtx.textBaseline='middle';nCtx.fillText(i,n.x,n.y);
    });
    requestAnimationFrame(animNet);
}
document.getElementById('generateNetwork').addEventListener('click',generateNet);
document.getElementById('addNode').addEventListener('click',()=>{
    netNodes.push(new NetNode(Math.random()*(networkCanvas.width-100)+50,Math.random()*(networkCanvas.height-100)+50));
    if(netNodes.length>1)netEdges.push({a:Math.floor(Math.random()*(netNodes.length-1)),b:netNodes.length-1});
});
generateNet();animNet();

/* ═══════════════════════════════════════════════
   DATA STRUCTURES — STACK
═══════════════════════════════════════════════ */
let stackData=[];
const stackCvs=document.getElementById('stackCanvas');const stCtx=stackCvs.getContext('2d');
function drawStack(highlight=-1){
    stCtx.clearRect(0,0,stackCvs.width,stackCvs.height);
    const maxH=6,bW=180,bH=50,startX=(stackCvs.width-bW)/2,baseY=stackCvs.height-60;
    stCtx.fillStyle='rgba(255,255,255,0.05)';stCtx.strokeStyle='rgba(255,255,255,0.1)';stCtx.lineWidth=1;
    stCtx.fillRect(startX-10,baseY-maxH*bH-10,bW+20,maxH*bH+60);stCtx.strokeRect(startX-10,baseY-maxH*bH-10,bW+20,maxH*bH+60);
    stCtx.fillStyle='rgba(0,255,136,0.3)';stCtx.fillRect(startX-10,baseY,bW+20,10);stCtx.fillStyle='#00ff88';stCtx.font='12px Space Mono,monospace';stCtx.textAlign='center';stCtx.fillText('BOTTOM',startX+bW/2,baseY+28);
    stackData.slice(-maxH).forEach((val,i)=>{
        const y=baseY-bH*(i+1),isTop=i===Math.min(stackData.length,maxH)-1,isHL=highlight===i;
        const g=stCtx.createLinearGradient(0,y,0,y+bH);
        if(isHL){g.addColorStop(0,'#ffd93d');g.addColorStop(1,'#ff8800');}
        else if(isTop){g.addColorStop(0,'rgba(0,255,136,0.6)');g.addColorStop(1,'rgba(0,255,136,0.3)');}
        else{g.addColorStop(0,'rgba(0,212,255,0.3)');g.addColorStop(1,'rgba(0,212,255,0.15)');}
        stCtx.fillStyle=g;stCtx.fillRect(startX,y,bW,bH-4);
        stCtx.strokeStyle=isTop?'#00ff88':'rgba(0,212,255,0.5)';stCtx.lineWidth=isTop?2:1;stCtx.strokeRect(startX,y,bW,bH-4);
        stCtx.fillStyle='#fff';stCtx.font='bold 18px Exo 2,sans-serif';stCtx.textAlign='center';stCtx.fillText(val,startX+bW/2,y+bH/2-2);
        if(isTop){stCtx.fillStyle='#00ff88';stCtx.font='10px monospace';stCtx.textAlign='left';stCtx.fillText('← TOP',startX+bW+6,y+bH/2-2);}
    });
    if(stackData.length===0){stCtx.fillStyle='rgba(255,255,255,0.2)';stCtx.font='14px monospace';stCtx.textAlign='center';stCtx.fillText('Stack is empty',stackCvs.width/2,stackCvs.height/2);}
}
function stackPush(){const v=document.getElementById('stackInput').value;if(!v)return;if(stackData.length>=6){document.getElementById('stackMsg').textContent='Stack Overflow! Max 6 elements.';return;}stackData.push(parseInt(v));document.getElementById('stackMsg').textContent=`Pushed ${v} onto stack`;document.getElementById('stackInput').value='';drawStack(stackData.length-1);}
function stackPop(){if(!stackData.length){document.getElementById('stackMsg').textContent='Stack Underflow! Stack is empty.';return;}const v=stackData.pop();document.getElementById('stackMsg').textContent=`Popped ${v} from stack`;drawStack();}
function stackPeek(){if(!stackData.length){document.getElementById('stackMsg').textContent='Stack is empty!';return;}document.getElementById('stackMsg').textContent=`Top element: ${stackData[stackData.length-1]}`;drawStack(stackData.length-1);}
function stackClear(){stackData=[];document.getElementById('stackMsg').textContent='Stack cleared';drawStack();}
drawStack();

/* ─── QUEUE ─── */
let queueData=[];
const qCvs=document.getElementById('queueCanvas');const qCtx2=qCvs.getContext('2d');
function drawQueue(highlightIdx=-1){
    qCtx2.clearRect(0,0,qCvs.width,qCvs.height);
    const maxQ=6,bW=70,bH=70,gap=10,totalW=maxQ*(bW+gap),startX=(qCvs.width-totalW)/2,y=(qCvs.height-bH)/2;
    qCtx2.fillStyle='rgba(255,255,255,0.03)';qCtx2.strokeStyle='rgba(255,255,255,0.08)';qCtx2.lineWidth=1;
    qCtx2.fillRect(startX-10,y-30,totalW+20,bH+60);qCtx2.strokeRect(startX-10,y-30,totalW+20,bH+60);
    qCtx2.fillStyle='rgba(0,255,136,0.5)';qCtx2.font='11px monospace';qCtx2.textAlign='center';
    qCtx2.fillText('FRONT →',startX-46,y+bH/2+4);qCtx2.fillText('← REAR',startX+totalW+46,y+bH/2+4);
    queueData.slice(0,maxQ).forEach((val,i)=>{
        const x=startX+i*(bW+gap),isHL=i===highlightIdx;
        const g=qCtx2.createLinearGradient(x,y,x,y+bH);
        if(isHL){g.addColorStop(0,'#ffd93d');g.addColorStop(1,'#ff8800');}
        else if(i===0){g.addColorStop(0,'rgba(0,255,136,0.6)');g.addColorStop(1,'rgba(0,255,136,0.3)');}
        else{g.addColorStop(0,'rgba(0,212,255,0.3)');g.addColorStop(1,'rgba(0,212,255,0.15)');}
        qCtx2.fillStyle=g;qCtx2.fillRect(x,y,bW,bH);
        qCtx2.strokeStyle=i===0?'#00ff88':'rgba(0,212,255,0.4)';qCtx2.lineWidth=i===0?2:1;qCtx2.strokeRect(x,y,bW,bH);
        qCtx2.fillStyle='#fff';qCtx2.font='bold 16px Exo 2,sans-serif';qCtx2.textAlign='center';qCtx2.fillText(val,x+bW/2,y+bH/2+6);
    });
    if(queueData.length===0){qCtx2.fillStyle='rgba(255,255,255,0.2)';qCtx2.font='14px monospace';qCtx2.textAlign='center';qCtx2.fillText('Queue is empty',qCvs.width/2,qCvs.height/2);}
}
function queueEnqueue(){const v=document.getElementById('queueInput').value;if(!v)return;if(queueData.length>=6){document.getElementById('queueMsg').textContent='Queue full! Max 6.';return;}queueData.push(parseInt(v));document.getElementById('queueMsg').textContent=`Enqueued ${v} at rear`;document.getElementById('queueInput').value='';drawQueue(queueData.length-1);}
function queueDequeue(){if(!queueData.length){document.getElementById('queueMsg').textContent='Queue is empty!';return;}const v=queueData.shift();document.getElementById('queueMsg').textContent=`Dequeued ${v} from front`;drawQueue();}
function queueFront(){if(!queueData.length){document.getElementById('queueMsg').textContent='Queue is empty!';return;}document.getElementById('queueMsg').textContent=`Front element: ${queueData[0]}`;drawQueue(0);}
function queueClear(){queueData=[];document.getElementById('queueMsg').textContent='Queue cleared';drawQueue();}
drawQueue();

/* ─── LINKED LIST ─── */
let llData=[];
const llCvs=document.getElementById('llCanvas');const llCtx=llCvs.getContext('2d');
function drawLL(highlight=-1){
    llCtx.clearRect(0,0,llCvs.width,llCvs.height);
    if(llData.length===0){llCtx.fillStyle='rgba(255,255,255,0.2)';llCtx.font='14px monospace';llCtx.textAlign='center';llCtx.fillText('Linked List is empty — add nodes!',llCvs.width/2,llCvs.height/2);return;}
    const nW=70,nH=50,gap=40,totalW=llData.length*(nW+gap),startX=Math.max(20,(llCvs.width-totalW)/2),y=(llCvs.height-nH)/2;
    llData.forEach((val,i)=>{
        const x=startX+i*(nW+gap);
        const isHL=i===highlight;
        llCtx.fillStyle=isHL?'rgba(255,217,61,0.4)':'rgba(0,255,136,0.15)';llCtx.strokeStyle=isHL?'#ffd93d':'#00ff88';llCtx.lineWidth=2;
        llCtx.fillRect(x,y,nW*0.6,nH);llCtx.strokeRect(x,y,nW*0.6,nH);
        llCtx.fillStyle='rgba(0,212,255,0.15)';llCtx.strokeStyle='rgba(0,212,255,0.5)';
        llCtx.fillRect(x+nW*0.6,y,nW*0.4,nH);llCtx.strokeRect(x+nW*0.6,y,nW*0.4,nH);
        llCtx.fillStyle='#fff';llCtx.font='bold 14px monospace';llCtx.textAlign='center';llCtx.fillText(val,x+nW*0.3,y+nH/2+5);
        llCtx.fillStyle='rgba(0,212,255,0.8)';llCtx.font='10px monospace';llCtx.fillText('→',x+nW*0.8,y+nH/2+4);
        if(i<llData.length-1){llCtx.beginPath();llCtx.moveTo(x+nW,y+nH/2);llCtx.lineTo(x+nW+gap,y+nH/2);llCtx.strokeStyle='rgba(0,212,255,0.6)';llCtx.lineWidth=2;llCtx.stroke();llCtx.beginPath();llCtx.moveTo(x+nW+gap-8,y+nH/2-6);llCtx.lineTo(x+nW+gap,y+nH/2);llCtx.lineTo(x+nW+gap-8,y+nH/2+6);llCtx.stroke();}
        else{llCtx.fillStyle='rgba(255,68,68,0.7)';llCtx.font='10px monospace';llCtx.textAlign='center';llCtx.fillText('NULL',x+nW*0.8,y+nH/2+4);}
        if(i===0){llCtx.fillStyle='#ffd93d';llCtx.font='11px monospace';llCtx.textAlign='center';llCtx.fillText('HEAD',x+nW*0.3,y-10);}
        if(i===llData.length-1){llCtx.fillStyle='#a855f7';llCtx.font='11px monospace';llCtx.textAlign='center';llCtx.fillText('TAIL',x+nW*0.3,y+nH+18);}
    });
}
function llAddFront(){const v=document.getElementById('llInput').value;if(!v||llData.length>=8)return;llData.unshift(parseInt(v));document.getElementById('llMsg').textContent=`Added ${v} at head`;document.getElementById('llInput').value='';drawLL(0);}
function llAddEnd(){const v=document.getElementById('llInput').value;if(!v||llData.length>=8)return;llData.push(parseInt(v));document.getElementById('llMsg').textContent=`Added ${v} at tail`;document.getElementById('llInput').value='';drawLL(llData.length-1);}
function llDeleteFront(){if(!llData.length)return;const v=llData.shift();document.getElementById('llMsg').textContent=`Deleted head node: ${v}`;drawLL();}
function llDeleteEnd(){if(!llData.length)return;const v=llData.pop();document.getElementById('llMsg').textContent=`Deleted tail node: ${v}`;drawLL();}
function llClear(){llData=[];document.getElementById('llMsg').textContent='List cleared';drawLL();}
drawLL();

/* ─── HASH TABLE ─── */
const HT_SIZE=8;let htTable=Array(HT_SIZE).fill(null).map(()=>[]);
const htCvs=document.getElementById('htCanvas');const htCtx=htCvs.getContext('2d');
function htHash(key){let h=0;for(const c of String(key))h=(h*31+c.charCodeAt(0))%HT_SIZE;return h;}
function drawHT(highlight=-1){
    htCtx.clearRect(0,0,htCvs.width,htCvs.height);
    const bW=60,bH=40,startX=30,startY=30,gap=20;
    htTable.forEach((bucket,i)=>{
        const y=startY+i*(bH+gap);const isHL=i===highlight;
        htCtx.fillStyle=isHL?'rgba(255,217,61,0.3)':'rgba(168,85,247,0.2)';
        htCtx.strokeStyle=isHL?'#ffd93d':'rgba(168,85,247,0.5)';htCtx.lineWidth=2;
        htCtx.fillRect(startX,y,bW,bH);htCtx.strokeRect(startX,y,bW,bH);
        htCtx.fillStyle=isHL?'#ffd93d':'rgba(168,85,247,0.8)';htCtx.font='11px monospace';htCtx.textAlign='center';htCtx.fillText(`[${i}]`,startX+bW/2,y+bH/2+4);
        bucket.forEach((kv,j)=>{
            const bx=startX+bW+j*(bW+20)+20;
            htCtx.fillStyle='rgba(0,255,136,0.2)';htCtx.strokeStyle='#00ff88';htCtx.lineWidth=1.5;
            htCtx.fillRect(bx,y,bW+20,bH);htCtx.strokeRect(bx,y,bW+20,bH);
            htCtx.fillStyle='#fff';htCtx.font='11px monospace';htCtx.textAlign='center';
            htCtx.fillText(`${kv.k}:${kv.v}`,bx+(bW+20)/2,y+bH/2+4);
            if(j<bucket.length-1){htCtx.beginPath();htCtx.moveTo(bx+bW+20,y+bH/2);htCtx.lineTo(bx+bW+30,y+bH/2);htCtx.strokeStyle='rgba(0,212,255,0.6)';htCtx.lineWidth=2;htCtx.stroke();}
        });
        if(bucket.length===0){htCtx.fillStyle='rgba(255,255,255,0.15)';htCtx.font='10px monospace';htCtx.textAlign='left';htCtx.fillText('empty',startX+bW+8,y+bH/2+4);}
    });
}
function htInsert(){const k=document.getElementById('htKey').value,v=document.getElementById('htVal').value;if(!k||!v)return;const h=htHash(k);const existing=htTable[h].findIndex(kv=>kv.k===k);if(existing>=0)htTable[h][existing].v=v;else htTable[h].push({k,v});document.getElementById('htMsg').textContent=`Inserted [${k}:${v}] at bucket ${h}`;document.getElementById('htKey').value='';document.getElementById('htVal').value='';drawHT(h);}
function htGet(){const k=document.getElementById('htSearch').value;if(!k)return;const h=htHash(k);const found=htTable[h].find(kv=>kv.k===k);document.getElementById('htMsg').textContent=found?`Found: ${k} → ${found.v} (bucket ${h})`:`Key '${k}' not found (bucket ${h})`;document.getElementById('htSearch').value='';drawHT(h);}
function htClear(){htTable=Array(HT_SIZE).fill(null).map(()=>[]);document.getElementById('htMsg').textContent='Hash table cleared';drawHT();}
drawHT();

/* ─── MIN HEAP ─── */
let heapData=[];
const heapCvs=document.getElementById('heapCanvas');const hpCtx=heapCvs.getContext('2d');
function heapifyUp(i){while(i>0){const p=Math.floor((i-1)/2);if(heapData[p]>heapData[i]){[heapData[p],heapData[i]]=[heapData[i],heapData[p]];i=p;}else break;}}
function heapifyDown(i){const n=heapData.length;while(true){let min=i,l=2*i+1,r=2*i+2;if(l<n&&heapData[l]<heapData[min])min=l;if(r<n&&heapData[r]<heapData[min])min=r;if(min===i)break;[heapData[i],heapData[min]]=[heapData[min],heapData[i]];i=min;}}
function drawHeap(highlight=-1){
    hpCtx.clearRect(0,0,heapCvs.width,heapCvs.height);
    if(!heapData.length){hpCtx.fillStyle='rgba(255,255,255,0.2)';hpCtx.font='14px monospace';hpCtx.textAlign='center';hpCtx.fillText('Heap is empty — insert values!',heapCvs.width/2,heapCvs.height/2);return;}
    const levels=Math.floor(Math.log2(heapData.length))+1;
    const nodePos=[];
    heapData.forEach((v,i)=>{
        const level=Math.floor(Math.log2(i+1));
        const posInLevel=i-(Math.pow(2,level)-1);
        const nodesInLevel=Math.pow(2,level);
        const x=heapCvs.width/(nodesInLevel+1)*(posInLevel+1);
        const y=60+level*90;
        nodePos[i]={x,y};
        if(i>0){const pi=Math.floor((i-1)/2);const p=nodePos[pi];hpCtx.beginPath();hpCtx.moveTo(p.x,p.y+20);hpCtx.lineTo(x,y-20);hpCtx.strokeStyle='rgba(0,212,255,0.4)';hpCtx.lineWidth=2;hpCtx.stroke();}
    });
    heapData.forEach((v,i)=>{
        const {x,y}=nodePos[i];const isHL=i===highlight;
        hpCtx.beginPath();hpCtx.arc(x,y,22,0,Math.PI*2);
        if(isHL)hpCtx.fillStyle='rgba(255,217,61,0.9)';
        else if(i===0)hpCtx.fillStyle='rgba(255,68,68,0.8)';
        else hpCtx.fillStyle='rgba(168,85,247,0.7)';
        hpCtx.fill();hpCtx.strokeStyle='rgba(255,255,255,0.3)';hpCtx.lineWidth=2;hpCtx.stroke();
        hpCtx.fillStyle='#fff';hpCtx.font='bold 13px monospace';hpCtx.textAlign='center';hpCtx.textBaseline='middle';hpCtx.fillText(v,x,y);
        if(i===0){hpCtx.fillStyle='#ff4444';hpCtx.font='10px monospace';hpCtx.textBaseline='alphabetic';hpCtx.fillText('MIN',x,y-28);}
    });
}
function heapInsert(){const v=parseInt(document.getElementById('heapInput').value);if(isNaN(v)||heapData.length>=15)return;heapData.push(v);heapifyUp(heapData.length-1);document.getElementById('heapMsg').textContent=`Inserted ${v}. Min: ${heapData[0]}`;document.getElementById('heapInput').value='';drawHeap(0);}
function heapExtractMin(){if(!heapData.length)return;const min=heapData[0];heapData[0]=heapData.pop();if(heapData.length)heapifyDown(0);document.getElementById('heapMsg').textContent=`Extracted min: ${min}. New min: ${heapData[0]??'—'}`;drawHeap();}
function heapClear(){heapData=[];document.getElementById('heapMsg').textContent='Heap cleared';drawHeap();}
drawHeap();

/* ═══════════════════════════════════════════════
   AI QUIZ
═══════════════════════════════════════════════ */
let quizTopic='python',quizDiff='beginner',quizScore=0,quizTotal=0,currentAnswer='',quizRunning=false;

document.querySelectorAll('.qt-btn').forEach(b=>{b.addEventListener('click',()=>{document.querySelectorAll('.qt-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');quizTopic=b.dataset.topic;});});
document.querySelectorAll('.qd-btn').forEach(b=>{b.addEventListener('click',()=>{document.querySelectorAll('.qd-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');quizDiff=b.dataset.diff;});});

const topicNames={python:'Python',dsa:'Data Structures & Algorithms',javascript:'JavaScript',os:'Operating Systems',networking:'Networking',aiml:'AI & Machine Learning'};

async function startQuiz(){
    quizScore=0;quizTotal=0;quizRunning=true;
    document.getElementById('quizSetup').style.display='none';
    document.getElementById('quizResults').style.display='none';
    document.getElementById('quizActive').style.display='block';
    document.getElementById('quizTopicLabel').textContent=topicNames[quizTopic]+' Quiz';
    await nextQuestion();
}

async function nextQuestion(){
    if(quizTotal>=10){endQuiz();return;}
    document.getElementById('nextQuizBtn').style.display='none';
    document.getElementById('quizFeedback').textContent='';document.getElementById('quizFeedback').className='quiz-feedback';
    document.getElementById('quizOptions').innerHTML='';
    document.getElementById('quizQuestionBox').innerHTML='<div class="quiz-loading"><i class="fas fa-spinner fa-spin"></i> Generating question...</div>';
    document.getElementById('quizProgress').textContent=`Q ${quizTotal+1}/10`;
    document.getElementById('quizScore').textContent=`Score: ${quizScore}/${quizTotal}`;

    const prompt=`You are a CS quiz generator. Generate exactly 1 ${quizDiff}-level multiple choice question about ${topicNames[quizTopic]}.
Respond ONLY with a JSON object (no markdown, no backticks) in this exact format:
{"question":"...","options":["A) ...","B) ...","C) ...","D) ..."],"answer":"A","explanation":"brief explanation"}`;
    try {
        const res=await fetch('/api/ai',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:600,messages:[{role:'user',content:prompt}]})});
        const data=await res.json();
        const text=data.content.map(c=>c.text||'').join('').trim();
        const clean=text.replace(/```json|```/g,'').trim();
        const q=JSON.parse(clean);
        currentAnswer=q.answer;
        document.getElementById('quizQuestionBox').textContent=`Q${quizTotal+1}. ${q.question}`;
        const opts=document.getElementById('quizOptions');
        q.options.forEach(opt=>{
            const btn=document.createElement('button');btn.className='quiz-opt';btn.textContent=opt;
            btn.addEventListener('click',()=>checkAnswer(opt[0],q.answer,q.explanation,q.options));
            opts.appendChild(btn);
        });
        quizTotal++;
        document.getElementById('quizProgress').textContent=`Q ${quizTotal}/10`;
    } catch(e){
        document.getElementById('quizQuestionBox').textContent='⚠️ Could not load question. Check connection and try again.';
        document.getElementById('nextQuizBtn').style.display='flex';
    }
}

function checkAnswer(chosen,correct,explanation,options){
    document.querySelectorAll('.quiz-opt').forEach(b=>{
        b.disabled=true;
        if(b.textContent.startsWith(correct))b.classList.add('correct');
        else if(b.textContent.startsWith(chosen)&&chosen!==correct)b.classList.add('wrong');
    });
    const fb=document.getElementById('quizFeedback');
    if(chosen===correct){
        quizScore++;fb.textContent=`✅ Correct! ${explanation}`;fb.className='quiz-feedback correct-fb';
    } else {
        fb.textContent=`❌ Wrong. Correct: ${correct}. ${explanation}`;fb.className='quiz-feedback wrong-fb';
    }
    document.getElementById('quizScore').textContent=`Score: ${quizScore}/${quizTotal}`;
    document.getElementById('nextQuizBtn').style.display='flex';
}

function endQuiz(){
    document.getElementById('quizActive').style.display='none';
    document.getElementById('quizResults').style.display='block';
    const pct=quizTotal>0?Math.round(quizScore/quizTotal*100):0;
    document.getElementById('finalScore').textContent=`${quizScore}/${quizTotal}`;
    document.getElementById('resultDesc').textContent=`You answered ${quizScore} out of ${quizTotal} correctly (${pct}%)`;
    const msgs={90:'🏆 Outstanding! You\'re a master!',70:'🎉 Great job! Keep it up!',50:'📚 Good effort! Review the topics.',0:'💪 Keep practicing — you\'ll get there!'};
    const key=Object.keys(msgs).reverse().find(k=>pct>=parseInt(k));
    document.getElementById('resultMsg').textContent=msgs[key];
    quizRunning=false;
}

function resetQuiz(){
    document.getElementById('quizResults').style.display='none';
    document.getElementById('quizSetup').style.display='block';
}
